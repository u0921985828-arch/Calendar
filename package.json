{
  "name": "neuroflow",
  "version": "1.0.0",
  "private": true,
  "description": "Calendario TDAH + AACC: app autónoma (public/demo.html) offline y cifrada, empaquetada como APK Android. UI de autoridad climática (C40.org).",
  "scripts": {
    "check": "node -e 'const fs=require(\"fs\");const h=fs.readFileSync(\"public/demo.html\",\"utf8\");const m=h.match(/<script>[\\s\\S]*?<\\/script>/g);fs.writeFileSync(\"/tmp/app.js\",m[m.length-1].replace(/^<script>/,\"\").replace(/<\\/script>$/,\"\"));' && node --check /tmp/app.js",
    "selftest": "node tests/selftest.cjs"
  },
  "devDependencies": {
    "playwright": "^1.47.0"
  }
}
